              <div t-attf-class="ftd-drawer-cell-value {{state.drawerVehicle.stale ? 'ftd-drawer-cell-value--amber' : ''}}">
                <t t-esc="f.stale"/>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>

  </div><!-- /ftd-wrap -->
  </t><!-- /t-else loading -->

</div><!-- /o_fleet_dashboard -->
</t>
</templates>
