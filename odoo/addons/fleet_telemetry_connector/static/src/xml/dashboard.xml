<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="fleet_telemetry_connector.Dashboard">
<div class="o_fleet_dashboard" style="padding:24px; background:#f8fafc;">

    <!-- Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h2 style="margin:0; color:#1e293b; font-size:1.5rem;">Fleet Telemetry Dashboard</h2>
        <button t-on-click="loadData" style="background:#6366f1; color:white; border:none; padding:8px 16px; border-radius:8px; cursor:pointer; font-size:0.9rem;">
            ⟳ Refresh
        </button>
    </div>

    <!-- Loading -->
    <t t-if="state.loading">
        <div style="text-align:center; padding:60px; color:#94a3b8;">Loading telemetry data...</div>
    </t>

    <t t-else="">
        <!-- KPI Cards -->
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px;">
            <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                <div style="color:#64748b; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em;">Total Vehicles</div>
                <div style="font-size:2rem; font-weight:700; color:#1e293b; margin-top:4px;"><t t-esc="totalVehicles"/></div>
            </div>
            <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                <div style="color:#64748b; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em;">Active (Ignition On)</div>
                <div style="font-size:2rem; font-weight:700; color:#10b981; margin-top:4px;"><t t-esc="activeVehicles"/></div>
            </div>
            <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                <div style="color:#64748b; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em;">Avg Speed (km/h)</div>
                <div style="font-size:2rem; font-weight:700; color:#6366f1; margin-top:4px;"><t t-esc="avgSpeed"/></div>
            </div>
            <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                <div style="color:#64748b; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em;">Avg Fuel (%)</div>
                <div style="font-size:2rem; font-weight:700; color:#f59e0b; margin-top:4px;"><t t-esc="avgFuel"/></div>
            </div>
        </div>

        <!-- Charts Row -->
        <div style="display:grid; grid-template-columns:2fr 2fr 1fr; gap:16px; margin-bottom:24px;">
            <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                <h4 style="margin:0 0 16px; color:#1e293b;">Speed per Vehicle (km/h)</h4>
                <canvas id="speedChart" height="200"/>
            </div>
            <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                <h4 style="margin:0 0 16px; color:#1e293b;">Fuel Level per Vehicle (%)</h4>
                <canvas id="fuelChart" height="200"/>
            </div>
            <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                <h4 style="margin:0 0 16px; color:#1e293b;">Ignition Status</h4>
                <canvas id="ignitionChart" height="200"/>
            </div>
        </div>

        <!-- Vehicle Table -->
        <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,0.08); margin-bottom:24px;">
            <h4 style="margin:0 0 16px; color:#1e293b;">Vehicle Status Overview</h4>
            <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
                <thead>
                    <tr style="border-bottom:2px solid #e2e8f0;">
                        <th style="text-align:left; padding:10px 12px; color:#64748b;">Device ID</th>
                        <th style="text-align:center; padding:10px 12px; color:#64748b;">Status</th>
                        <th style="text-align:center; padding:10px 12px; color:#64748b;">Speed</th>
                        <th style="text-align:center; padding:10px 12px; color:#64748b;">Fuel</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="state.vehicles.slice(0,10)" t-as="vehicle" t-key="vehicle.device_id">
                        <tr style="border-bottom:1px solid #f1f5f9;">
                            <td style="padding:10px 12px; font-weight:500; color:#1e293b;">
                                <t t-esc="vehicle.device_id"/>
                            </td>
                            <td style="text-align:center; padding:10px 12px;">
                                <span t-if="vehicle.ignition" style="background:#d1fae5; color:#065f46; padding:3px 10px; border-radius:10px; font-size:0.8rem;">Active</span>
                                <span t-else="" style="background:#fee2e2; color:#991b1b; padding:3px 10px; border-radius:10px; font-size:0.8rem;">Inactive</span>
                            </td>
                            <td style="text-align:center; padding:10px 12px; color:#475569;">
                                <t t-esc="vehicle.speed"/> km/h
                            </td>
                            <td style="text-align:center; padding:10px 12px; color:#475569;">
                                <t t-esc="vehicle.fuel_level"/>%
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <div t-if="state.vehicles.length > 10" style="text-align:center; padding:10px; color:#94a3b8; font-size:0.85rem;">
                + <t t-esc="state.vehicles.length - 10"/> more vehicles
            </div>
        </div>

        <!-- Map -->
        <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
            <h4 style="margin:0 0 16px; color:#1e293b;">Vehicle Locations</h4>
            <div id="fleetMap" style="height:400px; border-radius:8px;"/>
        </div>
    </t>
</div>
</t>
</templates>