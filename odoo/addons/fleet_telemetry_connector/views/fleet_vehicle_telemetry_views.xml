<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================ -->
        <!-- SEARCH VIEW                                  -->
        <!-- ============================================ -->
        <record id="view_fleet_vehicle_telemetry_search" model="ir.ui.view">
            <field name="name">fleet.vehicle.telemetry.search</field>
            <field name="model">fleet.vehicle.telemetry</field>
            <field name="arch" type="xml">
                <search string="Search Telemetry">
                    <!-- Search fields -->
                    <field name="device_id" string="Device ID" filter_domain="[('device_id', 'ilike', self)]"/>
                    <field name="timestamp" string="Date"/>
                    <field name="speed" string="Speed"/>
                    
                    <!-- Filters -->
                    <filter string="Ignition On" name="ignition_on" domain="[('ignition', '=', True)]"/>
                    <filter string="Ignition Off" name="ignition_off" domain="[('ignition', '=', False)]"/>
                    <filter string="Low Fuel (&lt;20%)" name="low_fuel" domain="[('fuel_level', '&lt;', 20)]"/>
                    <filter string="High Speed (&gt;80km/h)" name="high_speed" domain="[('speed', '&gt;', 80)]"/>
                    <filter string="Today" name="today" domain="[('timestamp', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                    <filter string="Last 24 Hours" name="last_24h" domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                    
                    <!-- Group By -->
                    <group expand="0" string="Group By">
                        <filter string="Device" name="group_by_device" context="{'group_by': 'device_id'}"/>
                        <filter string="Date" name="group_by_date" context="{'group_by': 'timestamp:day'}"/>
                        <filter string="Ignition Status" name="group_by_ignition" context="{'group_by': 'ignition'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- TREE VIEW (Enhanced with colors)             -->
        <!-- ============================================ -->
        <record id="view_fleet_vehicle_telemetry_tree" model="ir.ui.view">
            <field name="name">fleet.vehicle.telemetry.tree</field>
            <field name="model">fleet.vehicle.telemetry</field>
            <field name="arch" type="xml">
                <tree string="Fleet Telemetry" 
                      default_order="timestamp desc"
                      decoration-danger="fuel_level &lt; 20"
                      decoration-warning="speed &gt; 80"
                      decoration-success="ignition">
                    <field name="device_id"/>
                    <field name="timestamp"/>
                    <field name="latitude"/>
                    <field name="longitude"/>
                    <field name="speed"/>
                    <field name="fuel_level"/>
                    <field name="ignition"/>
                </tree>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- FORM VIEW                                    -->
        <!-- ============================================ -->
        <record id="view_fleet_vehicle_telemetry_form" model="ir.ui.view">
            <field name="name">fleet.vehicle.telemetry.form</field>
            <field name="model">fleet.vehicle.telemetry</field>
            <field name="arch" type="xml">
                <form string="Vehicle Telemetry">
                    <header>
                        <button name="action_refresh_from_l4" string="Refresh from L4" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="device_id"/>
                                <field name="timestamp"/>
                                <field name="ignition"/>
                            </group>
                            <group>
                                <field name="speed"/>
                                <field name="fuel_level"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="latitude"/>
                                <field name="longitude"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Raw Payload">
                                <field name="payload" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- GRAPH VIEW                                   -->
        <!-- ============================================ -->
        <record id="view_fleet_vehicle_telemetry_graph" model="ir.ui.view">
            <field name="name">fleet.vehicle.telemetry.graph</field>
            <field name="model">fleet.vehicle.telemetry</field>
            <field name="arch" type="xml">
                <graph string="Telemetry Speed Over Time" type="line">
                    <field name="timestamp" type="row" interval="day"/>
                    <field name="speed" type="measure"/>
                    <field name="device_id" type="col"/>
                </graph>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- ACTIONS                                      -->
        <!-- ============================================ -->
        <record id="action_fleet_telemetry_owl_dashboard" model="ir.actions.client">
            <field name="name">Fleet Dashboard</field>
            <field name="tag">fleet_telemetry_dashboard</field>
        </record>

        <record id="action_fleet_vehicle_telemetry" model="ir.actions.act_window">
            <field name="name">Fleet Telemetry</field>
            <field name="res_model">fleet.vehicle.telemetry</field>
            <field name="view_mode">tree,form,graph</field>
            <field name="context">{'search_default_order_by_timestamp': 1}</field>
        </record>

        <!-- ============================================ -->
        <!-- MENU ITEMS                                   -->
        <!-- ============================================ -->
        <menuitem id="menu_fleet_telemetry_root" 
                  name="Fleet Telemetry" 
                  sequence="10"
                  web_icon="fleet_telemetry_connector,static/description/icon.png"/>

        <menuitem id="menu_fleet_telemetry_dashboard" 
                  name="Dashboard"
                  parent="menu_fleet_telemetry_root"
                  action="action_fleet_telemetry_owl_dashboard" 
                  sequence="1"/>

        <menuitem id="menu_fleet_telemetry_vehicles" 
                  name="Vehicles"
                  parent="menu_fleet_telemetry_root"
                  action="action_fleet_vehicle_telemetry" 
                  sequence="10"/>

    </data>
</odoo>